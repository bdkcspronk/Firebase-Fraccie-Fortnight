{
  "rules": {
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
      }
    },
    "teams": {
      "$team_id": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $team_id",
        "wins": { ".write": "auth != null && (auth.uid === $team_id || root.child('admins').child(auth.uid).val() === true)" },
        "losses": { ".write": "auth != null && (auth.uid === $team_id || root.child('admins').child(auth.uid).val() === true)" }
      }
    },
    "game": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "bars": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "battles": {
      "$battle_id": {
        ".read": "auth != null",
        ".write": "auth != null && (data.child('team_a').val() === auth.uid || data.child('team_b').val() === auth.uid || (!data.exists() && (newData.child('team_a').val() === auth.uid || newData.child('team_b').val() === auth.uid)) || root.child('admins').child(auth.uid).val() === true)"
      }
    }
  }
}
